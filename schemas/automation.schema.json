{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sozorock:on-bc-canada:schema:automation:v1",
  "title": "Portable learner-path automation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["automation"],
  "properties": {
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automation_id",
        "version",
        "mode",
        "reference_region",
        "external_side_effects",
        "workflows"
      ],
      "properties": {
        "automation_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "mode": {"enum": ["disabled", "sandbox", "production"]},
        "reference_region": {"const": "ca-central-1"},
        "external_side_effects": {"enum": ["disabled", "adapter_approved"]},
        "workflows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow_id", "trigger", "steps", "failure_route", "human_gate"],
            "properties": {
              "workflow_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "trigger": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event_type", "schema_version", "privacy_class"],
                "properties": {
                  "event_type": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
                  "schema_version": {"type": "string", "minLength": 1},
                  "privacy_class": {"enum": ["operational", "learner_private", "sensitive_support", "public_deidentified"]}
                }
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["step_id", "action", "success_event", "failure_event", "retry"],
                  "properties": {
                    "step_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                    "action": {"type": "string", "minLength": 2},
                    "success_event": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
                    "failure_event": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
                    "retry": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["max_attempts", "backoff_seconds"],
                      "properties": {
                        "max_attempts": {"type": "integer", "minimum": 0, "maximum": 10},
                        "backoff_seconds": {"type": "integer", "minimum": 0}
                      }
                    }
                  }
                }
              },
              "failure_route": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event_type", "owner_role", "reason_field"],
                "properties": {
                  "event_type": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
                  "owner_role": {"type": "string", "minLength": 2},
                  "reason_field": {"type": "string", "minLength": 2}
                }
              },
              "human_gate": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "gate_id", "required_role", "evidence"],
                "properties": {
                  "mode": {"enum": ["automated", "human_authorized"]},
                  "gate_id": {"type": "string", "minLength": 2},
                  "required_role": {"type": "string", "minLength": 2},
                  "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                }
              }
            }
          }
        }
      }
    }
  }
}
