{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sozorock:on-bc-canada:schema:release-manifest:v1",
  "title": "Curriculum release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "program_id",
    "release_version",
    "compiler_version",
    "source_digest",
    "source_files",
    "artifacts",
    "claims_profile",
    "content_status",
    "model_dependency",
    "human_gates"
  ],
  "properties": {
    "release_id": {"type": "string", "minLength": 8},
    "program_id": {"type": "string", "minLength": 3},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "compiler_version": {"type": "string"},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^/].*\\.yaml$"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "module_id"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "module_id": {"type": "string", "minLength": 2}
        }
      }
    },
    "claims_profile": {"const": "public-launch"},
    "content_status": {"type": "string"},
    "model_dependency": {"const": "none-at-release-time"},
    "human_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
