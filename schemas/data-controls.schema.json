{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sozorock:on-bc-canada:schema:data-controls:v1",
  "title": "Program data controls",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_controls"],
  "properties": {
    "data_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "version", "reference_region", "record_classes", "provider_boundaries"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "reference_region": {"const": "ca-central-1"},
        "record_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "purpose", "allowed_fields", "prohibited_fields", "storage", "retention_class", "deletion_trigger", "access_roles"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "purpose": {"type": "string", "minLength": 8},
              "allowed_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "prohibited_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "storage": {
                "type": "object",
                "additionalProperties": false,
                "required": ["primary", "region", "encryption", "versioning"],
                "properties": {
                  "primary": {"type": "string", "minLength": 2},
                  "region": {"const": "ca-central-1"},
                  "encryption": {"type": "string", "minLength": 2},
                  "versioning": {"type": "boolean"}
                }
              },
              "retention_class": {"enum": ["short", "cohort_lifecycle", "credential_record", "quality_record"]},
              "deletion_trigger": {"type": "string", "minLength": 8},
              "access_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        },
        "provider_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "permitted_data_classes", "prohibited_data_classes", "region_record", "cross_border_access", "training_on_customer_data", "deletion_route"],
            "properties": {
              "provider": {"type": "string", "minLength": 2},
              "permitted_data_classes": {"type": "array", "items": {"type": "string"}},
              "prohibited_data_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "region_record": {"type": "string", "minLength": 2},
              "cross_border_access": {"enum": ["not_permitted", "controlled", "possible"]},
              "training_on_customer_data": {"enum": ["not_permitted", "configurable", "unknown"]},
              "deletion_route": {"type": "string", "minLength": 2}
            }
          }
        }
      }
    }
  }
}
