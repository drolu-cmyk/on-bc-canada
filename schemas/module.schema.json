{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sozorock.example/schemas/module.schema.json",
  "title": "Applied AI Training for Canada module specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["module_id", "title", "version", "domain", "outcomes", "evidence", "delivery", "change_resilience"],
  "properties": {
    "module_id": {"type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 5},
    "version": {"type": "string"},
    "domain": {"enum": ["common_core", "applied_ai", "cybersecurity_grc", "ai_governance", "cloud", "integrated_practicum"]},
    "description": {"type": "string"},
    "outcomes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "level"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string", "minLength": 20},
          "level": {"enum": ["explain", "apply", "analyze", "evaluate", "design", "defend"]},
          "stable": {"type": "boolean"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "type", "maps_to_outcomes", "rubric_id"],
        "properties": {
          "artifact_id": {"type": "string"},
          "type": {"enum": ["brief", "diagram", "memo", "risk_register", "control_matrix", "lab_notebook", "evaluation_report", "presentation", "oral_defense", "portfolio"]},
          "maps_to_outcomes": {"type": "array", "items": {"type": "string"}},
          "rubric_id": {"type": "string"},
          "required_for_certificate": {"type": "boolean"}
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weeks", "live_sessions", "independent_work", "accessibility_path"],
      "properties": {
        "weeks": {"type": "integer", "minimum": 1},
        "live_sessions": {"type": "array", "items": {"type": "string"}},
        "independent_work": {"type": "array", "items": {"type": "string"}},
        "accessibility_path": {"type": "string"}
      }
    },
    "change_resilience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_concepts", "replaceable_tools", "substitution_test", "refresh_triggers"],
      "properties": {
        "invariant_concepts": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "replaceable_tools": {"type": "array", "items": {"type": "string"}},
        "substitution_test": {"type": "string", "minLength": 20},
        "refresh_triggers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "standards_map": {"type": "array", "items": {"type": "string"}},
    "safe_lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_data", "prohibited_data", "stop_conditions"],
      "properties": {
        "allowed_data": {"type": "array", "items": {"type": "string"}},
        "prohibited_data": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    }
  }
}
