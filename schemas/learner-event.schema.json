{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sozorock.example/schemas/learner-event.schema.json",
  "title": "Learner and program event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "program_id", "schema_version", "actor", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 8},
    "event_type": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "program_id": {"type": "string"},
    "cohort_id": {"type": "string"},
    "learner_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["learner", "instructor", "automation", "operator", "external_system"]},
        "id": {"type": "string"}
      }
    },
    "payload": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "privacy_class": {"enum": ["operational", "learner_private", "sensitive_support", "public_deidentified"]},
    "retention_class": {"enum": ["short", "cohort_lifecycle", "credential_record", "quality_record"]},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_event_hash": {"type": "string"},
        "event_hash": {"type": "string"},
        "signing_key_id": {"type": "string"}
      }
    }
  }
}
