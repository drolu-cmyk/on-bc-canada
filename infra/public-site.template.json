{
 "AWSTemplateFormatVersion":"2010-09-09","Description":"Private S3 origin and CloudFront distribution for the canonical SozoRock Canada public site.",
 "Parameters":{"PublicSiteBucketName":{"Type":"String","AllowedPattern":"^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},"PriceClass":{"Type":"String","Default":"PriceClass_100","AllowedValues":["PriceClass_100","PriceClass_200","PriceClass_All"]},"CanonicalDomainName":{"Type":"String","Default":"canada.sozorock.com"},"CertificateArn":{"Type":"String","AllowedPattern":"^arn:[^:]+:acm:us-east-1:[0-9]{12}:certificate/[0-9a-f-]+$"},"PublishAlias":{"Type":"String","Default":"true","AllowedValues":["true","false"]}},
 "Conditions":{"PublishCustomDomain":{"Fn::Equals":[{"Ref":"PublishAlias"},"true"]}},
