  "PublicSiteOriginAccessControl":{"Type":"AWS::CloudFront::OriginAccessControl","Properties":{"OriginAccessControlConfig":{"Name":{"Fn::Sub":"${AWS::StackName}-public-site-oac"},"Description":"SigV4 access from CloudFront to private Canada public-site bucket.","OriginAccessControlOriginType":"s3","SigningBehavior":"always","SigningProtocol":"sigv4"}}},
  "CanonicalRouteFunction":{"Type":"AWS::CloudFront::Function","Properties":{"Name":{"Fn::Sub":"${AWS::StackName}-canonical-routes"},"AutoPublish":true,"FunctionConfig":{"Comment":"Redirect retired URLs and resolve clean static routes.","Runtime":"cloudfront-js-2.0"},"FunctionCode":"function handler(event){var r=event.request,u=r.uri;function go(v){return{statusCode:301,statusDescription:'Moved Permanently',headers:{location:{value:v},'cache-control':{value:'public, max-age=86400'}}};}if(u==='/index.html')return go('/');if(u==='/program'||u==='/program.html')return go('/programs');if(u==='/stories'||u==='/stories.html')return go('/insights');if(u==='/enroll'||u==='/enroll.html')return go('/register-interest');if(u.length>5&&u.slice(-5)==='.html')return go(u.slice(0,-5)||'/');var last=u.split('/').pop();if(u!=='/'&&last&&last.indexOf('.')===-1)r.uri=u+'.html';return r;}"}},
